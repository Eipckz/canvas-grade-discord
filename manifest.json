{
  "manifest_version": 3,
  "name": "Canvas Grades to Discord",
  "version": "1.4.0",
  "description": "Daily Canvas grades and recently graded assignment feedback to Discord.",
  "minimum_chrome_version": "120",
  "permissions": [
    "clipboardWrite",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://discord.com/api/webhooks/*",
    "https://utchattanooga.instructure.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas Grades"
  },
  "options_page": "options.html"
}
